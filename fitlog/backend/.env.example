# ─────────────────────────────────────────────────────────
# LAKSH Backend Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# ── Application ──
APP_NAME=LAKSH
APP_ENV=production

# ── Database (MySQL) ──
# If MySQL is unreachable, the app falls back to a local SQLite (laksh.db) automatically.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laksh_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
# Optionally, override the entire database URL:
# DATABASE_URL_OVERRIDE=mysql+pymysql://user:pass@host:port/dbname

# ── JWT Authentication ──
# IMPORTANT: Generate a strong random secret for production!
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── Google Fit / OAuth (Optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/activity
